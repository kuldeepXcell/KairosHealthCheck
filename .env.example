# Shown in the browser tab title as: Kairos Living | <ENV> | health Check
ENV=local

# JSON array of services. Each entry needs "name" (display label) and "baseUrl" (origin only, no trailing path).
# Health checks use GET {baseUrl}/health
#
# Browser calls require CORS on each service (Access-Control-Allow-Origin) or a reverse proxy that serves this UI
# and routes /health per service.
#
# Example (single line — recommended in .env):
VITE_SERVICES=[{"name":"Vendor API","baseUrl":"http://localhost:8000"},{"name":"Auth Service","baseUrl":"http://localhost:3001"}]

# Health poll interval in milliseconds (minimum 250). If unset or invalid, defaults to 5000 ms.
VITE_POLL_INTERVAL_MS=1000
